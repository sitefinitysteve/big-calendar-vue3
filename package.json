{
  "name": "big-calendar-vue3",
  "version": "1.3.1",
  "type": "module",
  "description": "A fully-featured calendar component for Vue 3 with 5 views, event CRUD, user filtering, and dark mode. Built with shadcn-vue and Tailwind CSS.",
  "author": "Steve McNiven-Scott <steve@sitefinitysteve.com> (https://www.sitefinitysteve.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sitefinitysteve/big-calendar-vue3.git"
  },
  "keywords": [
    "vue",
    "vue3",
    "calendar",
    "big-calendar",
    "shadcn-vue",
    "tailwindcss",
    "date-fns",
    "pinia"
  ],
  "exports": {
    ".": {
      "import": "./dist/big-calendar-vue3.js",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "main": "./dist/big-calendar-vue3.js",
  "module": "./dist/big-calendar-vue3.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:lib": "vue-tsc --noEmit && vite build --config vite.config.lib.ts",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "prepublishOnly": "npm run build:lib",
    "prepare": "husky",
    "pack": "npm run build:lib && npm pack",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "@internationalized/date": "^3.0.0",
    "@vee-validate/zod": "^4.0.0",
    "@vueuse/core": "^14.0.0 || ^15.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "date-fns": "^4.1.0",
    "lucide-vue-next": ">=0.400.0",
    "pinia": "^3.0.0 || ^4.0.0",
    "reka-ui": "^2.0.0",
    "tailwind-merge": "^3.0.0",
    "vee-validate": "^4.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.0.0",
    "zod": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.1",
    "@vee-validate/zod": "^4.15.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.6.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vee-validate": "^4.15.1",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^5.0.2",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.3.7",
    "zod": "^3.25.76"
  }
}
